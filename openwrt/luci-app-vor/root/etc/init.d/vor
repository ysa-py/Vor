#!/bin/sh /etc/rc.common
# VOR tunnel init — procd service rendering the xray config from UCI
# and arming the anti-DPI countermeasures.

START=99
USE_PROCD=1
PROG=/usr/bin/xray

start_service() {
	local enabled
	config_load vor
	config_get enabled config enabled 0
	[ "$enabled" = "1" ] || return 0

	vor_render_config || { echo "vor: config render failed" >&2; return 1; }

	procd_open_instance
	procd_set_param command "$PROG" run -c /var/run/vor/xray.json
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance

	/usr/bin/vor-countermeasure apply || true

	# Watchdog (transport ladder + blackout detection) via cron.
	[ -f /etc/crontabs/root ] || touch /etc/crontabs/root
	grep -q vor-watchdog /etc/crontabs/root || \
		echo '*/1 * * * * /usr/bin/vor-watchdog tick' >> /etc/crontabs/root
	/etc/init.d/cron restart
}

stop_service() {
	/usr/bin/vor-countermeasure clear || true
	sed -i '/vor-watchdog/d' /etc/crontabs/root 2>/dev/null
	/etc/init.d/cron restart
}

reload_service() {
	stop_service
	start_service
}

# Render /var/run/vor/xray.json from UCI (mirror of vor-engine/src/xray.rs).
vor_render_config() {
	local address port uuid sni pbk sid path host
	local socks_port transport dns_mode doh_url bootstrap_ir domestic_resolver
	local split mss utls_rand fake_sni

	config_get address endpoint address
	config_get port endpoint port 443
	config_get uuid endpoint uuid
	config_get sni endpoint sni
	config_get pbk endpoint public_key
	config_get sid endpoint short_id
	config_get path endpoint path /vorws
	config_get host endpoint host
	config_get socks_port config socks_port 1080
	config_get transport config transport auto
	config_get dns_mode dns mode doh
	config_get doh_url dns doh_url "https://1.1.1.1/dns-query"
	config_get bootstrap_ir dns bootstrap_ir "10.202.10.202"
	config_get domestic_resolver dns domestic_resolver "78.157.42.100"
	config_get split dpi clienthello_split off
	config_get mss dpi mss_clamp
	config_get utls_rand dpi utls_randomized 1
	config_get fake_sni dpi fake_sni 0

	[ -n "$address" ] || return 1

	local fp="chrome"
	[ "$utls_rand" = "1" ] && fp="randomized"

	mkdir -p /var/run/vor

	local stream
	if [ -n "$pbk" ]; then
		stream="{\"network\":\"tcp\",\"security\":\"reality\",\"realitySettings\":{\"show\":false,\"serverName\":\"${sni:-www.microsoft.com}\",\"fingerprint\":\"$fp\",\"publicKey\":\"$pbk\",\"shortId\":\"$sid\",\"spiderX\":\"/\"}}"
	else
		stream="{\"network\":\"ws\",\"security\":\"tls\",\"tlsSettings\":{\"serverName\":\"${sni:-$host}\",\"fingerprint\":\"$fp\",\"allowInsecure\":false},\"wsSettings\":{\"path\":\"$path\",\"headers\":{\"Host\":\"${host:-$address}\"}}}"
	fi

	local dns
	case "$dns_mode" in
		bootstrap)
			dns="{\"servers\":[{\"address\":\"$bootstrap_ir\",\"domains\":[\"geosite:category-ir\"]},{\"address\":\"8.8.8.8\"}]}" ;;
		domestic)
			dns="{\"servers\":[{\"address\":\"$domestic_resolver\",\"domains\":[\"geosite:category-ir\"]},{\"address\":\"1.1.1.1\"}]}" ;;
		dot)
			dns="{\"servers\":[{\"address\":\"1.1.1.1\",\"port\":853}]}" ;;
		*)
			dns="{\"servers\":[\"$doh_url\",{\"address\":\"$domestic_resolver\",\"domains\":[\"geosite:category-ir\"]}]}" ;;
	esac

	local flow='""'
	[ -n "$pbk" ] && flow='"xtls-rprx-vision"'

	cat > /var/run/vor/xray.json <<EOF
{
  "log": {"loglevel": "warning"},
  "dns": $dns,
  "inbounds": [{
    "tag": "socks-in",
    "port": $socks_port,
    "listen": "0.0.0.0",
    "protocol": "socks",
    "settings": {"udp": true, "auth": "noauth"},
    "sniffing": {"enabled": true, "destOverride": ["http", "tls", "quic"]}
  }],
  "outbounds": [
    {
      "tag": "proxy",
      "protocol": "vless",
      "settings": {"vnext": [{"address": "$address", "port": $port,
        "users": [{"id": "$uuid", "encryption": "none", "level": 0, "flow": $flow}]}]},
      "streamSettings": $stream
    },
    {"tag": "direct-ir", "protocol": "freedom", "settings": {"domainStrategy": "UseIP"}}
  ],
  "routing": {
    "domainStrategy": "IPIfNonMatch",
    "rules": [
      {"type": "field", "outboundTag": "direct-ir", "domain": ["geosite:category-ir", "domain:ir"]},
      {"type": "field", "outboundTag": "direct-ir", "ip": ["geoip:ir", "geoip:private"]}
    ]
  }
}
EOF
	return 0
}
